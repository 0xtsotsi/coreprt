<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      com.coreprt.opencli-bridge.plist — auto-restart the OpenCLI browser
      bridge whenever it dies (system reboot, Chrome crash, daemon
      hang). Lets ggcoder keep driving Chrome for the operator while they
      are remote + AFK, even if the Mac rebooted overnight.

      Why this exists:
        `start-opencli-bridge.sh` is the foreground launcher the
        operator runs to bind the bridge (it holds caffeinate alive,
        prints the PID, then returns). If the bridge ever dies, the
        operator has to re-run the script — which they cannot do
        from a coffee shop. This plist watches a sentinel file the
        bridge updates and re-launches the script if the sentinel
        stops being touched.

      What this plist is NOT:
        - Not a launchd KeepAlive replacement for caffeinate. If the
          script itself dies, launchd restarts it and a fresh
          caffeinate takes over. If you need a single long-lived
          caffeinate across reboots, run the script inside a
          tmux/screen session instead.
        - Not a wake-from-sleep hook. macOS does not expose a portable
          "wake" event to launchd. For that, register a `pmset`
          schedule hook or just trust the sentinel-watch approach.

      Install:
        cp agents/_lib/com.coreprt.opencli-bridge.plist \
           ~/Library/LaunchAgents/com.coreprt.opencli-bridge.plist
        launchctl load -w ~/Library/LaunchAgents/com.coreprt.opencli-bridge.plist

      Prerequisite:
        The operator must have run
        ./agents/_lib/start-opencli-bridge.sh interactively at least once,
        so the unpacked extension is loaded in their default Chrome
        profile and `opencli doctor` reports the extension as connected.
    -->
    <key>Label</key>
    <string>com.coreprt.opencli-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gogetta/Documents/projects/CorePrt/agents/_lib/start-opencli-bridge.sh</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- Every 5 minutes, re-run the script. The script exits 0 in <2s
         once caffeinate is up; if it exits non-zero (e.g. extension
         dropped), launchd logs to StandardErrorPath. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/tmp/com.coreprt.opencli-bridge.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.coreprt.opencli-bridge.err</string>
</dict>
</plist>
