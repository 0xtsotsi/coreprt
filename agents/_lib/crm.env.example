# ~/Documents/projects/CorePrt/.gg/plans/example-crm.env
#
# Bridge config for the webrnds CRM layer (PR-5).
# Copy to ~/.config/coreprt/crm.env (mode 0600) to enable.
#
# By default the bridge runs in stub mode: it emits the same Nostr
# events (kind:43001, kind:30023, kind:1 RECEIPT) and logs to
# ~/.config/coreprt/crm-stub.log instead of POSTing to trycompai.
#
# To enable the real bridge:
#   1. CRM_PROVIDER=trycompai
#   2. set TRYCOMPAI_API_URL and TRYCOMPAI_TOKEN below
#   3. chmod 600 ~/.config/coreprt/crm.env

# CRM_PROVIDER=stub
# TRYCOMPAI_API_URL=https://crm.trycompai.com/api/v1
# TRYCOMPAI_TOKEN=<paste-from-1Password-or-wherever>